     feb_big = and(feb_mode,and(sched_use1,gt(abs(load0_3),feb_big_cut*3600)))
!------新增/修改，12月高负荷时追加大冷机1完整支路                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     dec_big = and(dec_mode,and(sched_use1,gt(abs(load0_3),dec_big_cut*3600)))
!------新增/修改，汇总非制冷季追加大冷机1支路启停信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     winter_big = feb_big+dec_big
!------新增/修改，5月超过阈值时提前投入两大一小全部三条支路                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
     may_high = and(may_mode,and(sched_use1,gt(abs(load0_3),may_cut*3600)))
!------新增/修改，5月冷却水泵及冷却塔1控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     p11_may = max(p11_base,may_high)
!------新增/修改，5月冷却水泵及冷却塔2控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     p22_may = max(p22_base,may_high)
!------新增/修改，5月冷却水泵及冷却塔3控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
     p33_may = max(p33_base,may_high)
!------新增/修改，5月1号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     bili11_may = max(bili11_base,may_high*bili_big_sp)
!------新增/修改，5月2号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     bili22_may = max(bili22_base,may_high*bili_second_sp)
!------新增/修改，5月3号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     bili33_may = max(bili33_base,may_high*bili_small_sp)
!------新增/修改，8月超过阈值时允许系统按原逻辑运行                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     aug_on = and(aug_mode,and(sched_use1,gt(abs(load0_3),aug_cut*3600)))
!------新增/修改，8月1号冷却水泵及冷却塔控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     p11_aug = aug_on*p11_base
!------新增/修改，8月2号冷却水泵及冷却塔控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     p22_aug = aug_on*p22_base
!------新增/修改，8月3号冷却水泵及冷却塔控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     p33_aug = aug_on*p33_base
!------新增/修改，8月1号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     bili11_aug = aug_on*bili11_base
!------新增/修改，8月2号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     bili22_aug = aug_on*bili22_base
!------新增/修改，8月3号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
     bili33_aug = aug_on*bili33_base
!------新增/修改，10月超过阈值时允许系统运行                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
     oct_on = and(oct_mode,and(sched_use1,gt(abs(load0_3),oct_cut*3600)))
!------新增/修改，10月低负荷段仅运行一台大冷机1完整支路                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
     oct_big = oct_on*le(abs(load0_3),1934*3600)
!------新增/修改，10月中负荷段运行一大一小完整支路                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     oct_mix = oct_on*gt(abs(load0_3),1934*3600)*le(abs(load0_3),3017*3600)
!------新增/修改，10月中高负荷段运行两台大冷机完整支路                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     oct_2big = oct_on*gt(abs(load0_3),3017*3600)*le(abs(load0_3),3868*3600)
!------新增/修改，10月高负荷段运行两大一小全部支路                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
     oct_all = oct_on*gt(abs(load0_3),3868*3600)
!------新增/修改，10月1号冷却水泵及冷却塔控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     p11_oct = oct_big+oct_mix+oct_2big+oct_all
!------新增/修改，10月2号冷却水泵及冷却塔控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     p22_oct = oct_2big+oct_all
!------新增/修改，10月3号冷却水泵及冷却塔控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
     p33_oct = oct_mix+oct_all
!------新增/修改，10月1号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
     bili11_oct = p11_oct*bili_big_sp
!------新增/修改，10月2号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
     bili22_oct = p22_oct*bili_second_sp
!------新增/修改，10月3号冷冻水泵控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
     bili33_oct = p33_oct*bili_small_sp
!------新增/修改，最终1号冷却水泵及冷却塔控制信号                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
     p11 = other_cool*p11_base+may_mode*p11_may+aug_mode*p11_aug+oct_mode*p11_oct+winter_big
