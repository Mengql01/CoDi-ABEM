* EQUATIONS "负荷判断与水泵变频控制"
* 
EQUATIONS 81
zhirepd = lt([94,1],0)
p11_base = and(sched_use1,p1)*[56,83]+p22_*[56,84] !------新增/修改，保存原冷却水泵1及冷却塔1控制逻辑，作为原始制冷季基础信号
p22_base = and(sched_use1,p2) !------新增/修改，保存原冷却水泵2及冷却塔2控制逻辑，作为原始制冷季基础信号
p33_base = and(sched_use1,p3)*[56,83]+p11_*[56,84] !------新增/修改，保存原冷却水泵3及冷却塔3控制逻辑，作为原始制冷季基础信号
p1 = gt(abs(load0_3),193.4*3600)
p2 = gt(abs(load0_3),1934*3600)
p3 = gt(abs(load0_3),3868*3600)
qiwangliuliang1 = (load0_3)/4.19/7
bili1 = qiwangliuliang1/308000
bili11_base = ((gt(bili1,0.77)*0.77+le(bili1,0.77)*gt(bili1,0.6)*bili1+le(bili1,0.6)*0.6)*ne(bili1,0)*p11_base*[56,83])+((gt(bili1,2.541)*0.77+le(bili1,2.541)*gt(bili1,2.177)*bili5+le(bili1,2.177)*0.6)*ne(bili1,0)*p22_*[56,84]) !------新增/修改，保存原1号冷冻水泵变频逻辑
bili2 = (qiwangliuliang1-238000)/308000
bili22_base = ((gt(bili1,1.545)*0.77+le(bili1,1.545)*gt(bili1,1.37)*bili2+le(bili1,1.37)*0.6)*ne(bili1,0)*p22_base*[56,83]) !------新增/修改，保存原2号冷冻水泵变频逻辑
bili3 = (qiwangliuliang1-238000*2)/146000
bili33_base = ((gt(bili1,1.98)*0.91+le(bili1,1.98)*gt(bili1,1.83)*bili3+le(bili1,1.83)*0.6)*ne(bili1,0)*p33_base*[56,83])+((gt(bili4,0.91)*0.91+le(bili4,0.91)*gt(bili4,0.6)*bili4+le(bili4,0.6)*0.6)*ne(bili4,0)*p11_*[56,84]) !------新增/修改，保存原3号冷冻水泵变频逻辑
sched_use1 = int([56,82]+0.7)
load0_3 = [94,1]*[56,82]
bili4 = qiwangliuliang1/146000
p11_ = and(sched_use1,gt(abs(load0_3),108.3*3600))
p22_ = and(sched_use1,gt(abs(load0_3),1083*3600))
bili5 = (qiwangliuliang1-133000)/146000
jan_mode = le(TIME,744) !------新增/修改，1月控制时段标志
feb_mode = gt(TIME,744)*le(TIME,1416) !------新增/修改，2月控制时段标志
mar_mode = gt(TIME,1416)*le(TIME,2160) !------新增/修改，3月控制时段标志
may_mode = gt(TIME,2880)*le(TIME,3624) !------新增/修改，5月特殊控制时段标志
aug_mode = gt(TIME,5088)*le(TIME,5832) !------新增/修改，8月特殊控制时段标志
oct_mode = gt(TIME,6552)*le(TIME,7296) !------新增/修改，10月特殊控制时段标志
nov_mode = gt(TIME,7296)*le(TIME,8016) !------新增/修改，11月控制时段标志
dec_mode = gt(TIME,8016) !------新增/修改，12月控制时段标志
noncool = jan_mode+feb_mode+mar_mode+nov_mode+dec_mode !------新增/修改，非制冷季标志
cool_mode = 1-noncool !------新增/修改，制冷季标志
other_cool = cool_mode-may_mode-aug_mode-oct_mode !------新增/修改，除5月、8月和10月外采用原始制冷季逻辑
bili_big_sp = (gt(bili1,0.77)*0.77+le(bili1,0.77)*gt(bili1,0.6)*bili1+le(bili1,0.6)*0.6)*ne(bili1,0) !------新增/修改，1号大冷机支路冷冻水泵变频比
bili_second_sp = (gt(bili1,1.545)*0.77+le(bili1,1.545)*gt(bili1,1.37)*bili2+le(bili1,1.37)*0.6)*ne(bili1,0) !------新增/修改，2号大冷机支路冷冻水泵变频比
bili_small_sp = (gt(bili4,0.91)*0.91+le(bili4,0.91)*gt(bili4,0.6)*bili4+le(bili4,0.6)*0.6)*ne(bili4,0) !------新增/修改，3号小冷机支路冷冻水泵变频比
jan_cut = 610 !------新增/修改，1月小冷机支路有效负荷阈值，单位kW
feb_big_cut = 190 !------新增/修改，2月追加大冷机1支路的有效负荷阈值，单位kW
mar_cut = 140 !------新增/修改，3月小冷机支路有效负荷阈值，单位kW
may_cut = 0 !------新增/修改，5月两大一小全部支路提前投入阈值，单位kW
aug_cut = 3200 !------新增/修改，8月系统允许运行的有效负荷阈值，单位kW
oct_cut = 1100 !------新增/修改，10月系统允许运行的有效负荷阈值，单位kW
dec_big_cut = 40 !------新增/修改，12月追加大冷机1支路的有效负荷阈值，单位kW
jan_small = and(jan_mode,and(sched_use1,gt(abs(load0_3),jan_cut*3600))) !------新增/修改，1月超过阈值时仅运行小冷机3完整支路
feb_small = and(feb_mode,and(sched_use1,gt(abs(load0_3),0))) !------新增/修改，2月有有效负荷时运行小冷机3完整支路
mar_small = and(mar_mode,and(sched_use1,gt(abs(load0_3),mar_cut*3600))) !------新增/修改，3月超过阈值时仅运行小冷机3完整支路
nov_small = and(nov_mode,and(sched_use1,gt(abs(load0_3),0))) !------新增/修改，11月有有效负荷时仅运行小冷机3完整支路
dec_small = and(dec_mode,and(sched_use1,gt(abs(load0_3),0))) !------新增/修改，12月有有效负荷时运行小冷机3完整支路
winter_small = jan_small+feb_small+mar_small+nov_small+dec_small !------新增/修改，汇总非制冷季小冷机3支路启停信号
feb_big = and(feb_mode,and(sched_use1,gt(abs(load0_3),feb_big_cut*3600))) !------新增/修改，2月高负荷时追加大冷机1完整支路
dec_big = and(dec_mode,and(sched_use1,gt(abs(load0_3),dec_big_cut*3600))) !------新增/修改，12月高负荷时追加大冷机1完整支路
winter_big = feb_big+dec_big !------新增/修改，汇总非制冷季追加大冷机1支路启停信号
may_high = and(may_mode,and(sched_use1,gt(abs(load0_3),may_cut*3600))) !------新增/修改，5月超过阈值时提前投入两大一小全部三条支路
p11_may = max(p11_base,may_high) !------新增/修改，5月冷却水泵及冷却塔1控制信号
p22_may = max(p22_base,may_high) !------新增/修改，5月冷却水泵及冷却塔2控制信号
p33_may = max(p33_base,may_high) !------新增/修改，5月冷却水泵及冷却塔3控制信号
bili11_may = max(bili11_base,may_high*bili_big_sp) !------新增/修改，5月1号冷冻水泵控制信号
bili22_may = max(bili22_base,may_high*bili_second_sp) !------新增/修改，5月2号冷冻水泵控制信号
bili33_may = max(bili33_base,may_high*bili_small_sp) !------新增/修改，5月3号冷冻水泵控制信号
aug_on = and(aug_mode,and(sched_use1,gt(abs(load0_3),aug_cut*3600))) !------新增/修改，8月超过阈值时允许系统按原逻辑运行
p11_aug = aug_on*p11_base !------新增/修改，8月1号冷却水泵及冷却塔控制信号
p22_aug = aug_on*p22_base !------新增/修改，8月2号冷却水泵及冷却塔控制信号
p33_aug = aug_on*p33_base !------新增/修改，8月3号冷却水泵及冷却塔控制信号
bili11_aug = aug_on*bili11_base !------新增/修改，8月1号冷冻水泵控制信号
bili22_aug = aug_on*bili22_base !------新增/修改，8月2号冷冻水泵控制信号
bili33_aug = aug_on*bili33_base !------新增/修改，8月3号冷冻水泵控制信号
oct_on = and(oct_mode,and(sched_use1,gt(abs(load0_3),oct_cut*3600))) !------新增/修改，10月超过阈值时允许系统运行
oct_big = oct_on*le(abs(load0_3),1934*3600) !------新增/修改，10月低负荷段仅运行一台大冷机1完整支路
oct_mix = oct_on*gt(abs(load0_3),1934*3600)*le(abs(load0_3),3017*3600) !------新增/修改，10月中负荷段运行一大一小完整支路
oct_2big = oct_on*gt(abs(load0_3),3017*3600)*le(abs(load0_3),3868*3600) !------新增/修改，10月中高负荷段运行两台大冷机完整支路
oct_all = oct_on*gt(abs(load0_3),3868*3600) !------新增/修改，10月高负荷段运行两大一小全部支路
p11_oct = oct_big+oct_mix+oct_2big+oct_all !------新增/修改，10月1号冷却水泵及冷却塔控制信号
p22_oct = oct_2big+oct_all !------新增/修改，10月2号冷却水泵及冷却塔控制信号
p33_oct = oct_mix+oct_all !------新增/修改，10月3号冷却水泵及冷却塔控制信号
bili11_oct = p11_oct*bili_big_sp !------新增/修改，10月1号冷冻水泵控制信号
bili22_oct = p22_oct*bili_second_sp !------新增/修改，10月2号冷冻水泵控制信号
bili33_oct = p33_oct*bili_small_sp !------新增/修改，10月3号冷冻水泵控制信号
p11 = other_cool*p11_base+may_mode*p11_may+aug_mode*p11_aug+oct_mode*p11_oct+winter_big !------新增/修改，最终1号冷却水泵及冷却塔控制信号
p22 = other_cool*p22_base+may_mode*p22_may+aug_mode*p22_aug+oct_mode*p22_oct !------新增/修改，最终2号冷却水泵及冷却塔控制信号
p33 = other_cool*p33_base+may_mode*p33_may+aug_mode*p33_aug+oct_mode*p33_oct+winter_small !------新增/修改，最终3号冷却水泵及冷却塔控制信号
bili11 = other_cool*bili11_base+may_mode*bili11_may+aug_mode*bili11_aug+oct_mode*bili11_oct+winter_big*bili_big_sp !------新增/修改，最终1号冷冻水泵控制信号
bili22 = other_cool*bili22_base+may_mode*bili22_may+aug_mode*bili22_aug+oct_mode*bili22_oct !------新增/修改，最终2号冷冻水泵控制信号
bili33 = other_cool*bili33_base+may_mode*bili33_may+aug_mode*bili33_aug+oct_mode*bili33_oct+winter_small*bili_small_sp !------新增/修改，最终3号冷冻水泵控制信号
